# llama.cpp Router preset - EXAMPLE / SYNTAX REFERENCE
#
#   Reads by:  llama-server --models-preset <file>
#   Referenced by:  references/assets/router-mode-preset.bat
#
# ---------------------------------------------------------------------------
# READ THIS FIRST
#
# This file is a *syntax* reference, not a runnable preset: the paths below use
# <models-dir> placeholders, and llama-server would fail on them literally. It
# exists because the router template needs something to point at and the skill
# previously shipped no sample at all.
#
# There are two ways to get a real one:
#
#   1. Generated (recommended) - the generator writes every tunable from
#      preset-overrides.json, which is the single source of truth:
#
#          python scripts/launcher_gen/update_launchers.py --yes
#
#      It writes <models-dir>\models-config.ini, and overwrites it in place,
#      so hand-edits there are lost on the next run. Tune preset-overrides.json
#      instead.
#
#   2. Hand-written - copy this file to <models-dir>\models-config.ini and
#      replace every <models-dir> with your real models directory.
#
# ---------------------------------------------------------------------------
# FORMAT
#
#   * plain INI - '#' or ';' starts a comment, blank lines are fine
#   * 'key = value' with spaces around '=' (both sides optional)
#   * section name in [] is the model id shown in the Web UI picker
#   * [*] applies to every model; per-section keys override it
#   * keys are llama-server CLI flags with the leading '--' dropped:
#         --ctx-size 65536   ->   ctx-size = 65536
#   * the three keys the generator treats specially are model / mmproj / alias,
#     because section membership is decided by them rather than by the file

# ---------------------------------------------------------------- defaults
[*]
ctx-size = 65536
n-gpu-layers = 99
cache-type-k = q8_0
cache-type-v = q8_0
flash-attn = on
jinja = true

# ------------------------------------------------------- a MoE model, offloaded
# n-cpu-moe keeps N layers' experts on the CPU. It is the difference between
# "loads with 3 GB free" and "OOMs", and the right value is per-model - measure
# it, do not copy one (see SKILL.md section five).
[Qwen3.6-35B-A3B-128K-MoE]
model = <models-dir>\Qwen3.6-35B-A3B-Q4_K_M\Qwen3.6-35B-A3B-Q4_K_M.gguf
alias = qwen36-35b
ctx-size = 131072
n-cpu-moe = 28
temp = 0.7
top-p = 0.95
top-k = 64

# ------------------------------------------------------- a vision model, plain
[Gemma4-12B-128K-IMG]
model = <models-dir>\gemma-4-12B-it-qat-UD-Q4_K_XL\gemma-4-12B-it-qat-UD-Q4_K_XL.gguf
mmproj = <models-dir>\gemma-4-12B-it-qat-UD-Q4_K_XL\mmproj-F16.gguf
alias = gemma4-12b
ctx-size = 131072

# --------------------------------------------- the SAME model plus an MTP draft
# A second section over the same weights - this is how you compare with and
# without speculative decoding without swapping files. The draft is itself a
# gguf; spec-draft-n-max 2 is the value measured on a 16 GB card.
[Gemma4-12B-128K-MTP]
model = <models-dir>\gemma-4-12B-it-qat-UD-Q4_K_XL\gemma-4-12B-it-qat-UD-Q4_K_XL.gguf
mmproj = <models-dir>\gemma-4-12B-it-qat-UD-Q4_K_XL\mmproj-F16.gguf
spec-type = draft-mtp
spec-draft-model = <models-dir>\gemma4_mtp\gemma-4-12b-it-Q8_0-MTP.gguf
spec-draft-n-max = 2
ctx-size = 131072
alias = gemma4-12b-mtp
